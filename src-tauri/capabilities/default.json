{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal desktop permissions for Prime Orbit windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    "opener:allow-default-urls"
  ]
}
