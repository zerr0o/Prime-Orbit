{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Minimal desktop permissions for Prime Orbit windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "mailto:*" },
        { "url": "tel:*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
